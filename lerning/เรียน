<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ศูนย์ฝึกอบรม HTML และพื้นที่เขียนโค้ดจริง</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #1e1e1e;
            color: #d4d4d4;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        /* ส่วนหัวหลัก */
        header {
            background-color: #252526;
            padding: 10px 20px;
            border-bottom: 1px solid #333;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header h1 {
            color: #4ec9b0;
            font-size: 18px;
            margin: 0;
        }
        header p {
            color: #9cdcfe;
            font-size: 13px;
            margin: 0;
        }

        /* โครงสร้างหน้าจอแบ่งซ้าย-ขวาหลัก */
        .workspace {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        /* ฝั่งซ้าย: บทเรียนและคำอธิบาย */
        .lessons-sidebar {
            width: 45%;
            background-color: #222;
            border-right: 1px solid #333;
            overflow-y: auto;
            padding: 15px;
        }

        /* ฝั่งขวา: พื้นที่เขียนโค้ด + หน้าจอพรีวิว */
        .editor-preview-area {
            width: 55%;
            display: flex;
            flex-direction: column;
            background-color: #1e1e1e;
        }

        /* สไตล์กล่องบทเรียนแต่ละข้อ */
        .lesson-card {
            background-color: #2d2d2d;
            border-radius: 6px;
            padding: 12px;
            margin-bottom: 15px;
            border: 1px solid #3d3d3d;
        }
        .lesson-card h3 {
            color: #4ec9b0;
            margin-top: 0;
            font-size: 15px;
            border-bottom: 1px solid #444;
            padding-bottom: 5px;
        }
        .lesson-card p, .lesson-card li {
            font-size: 13px;
            line-height: 1.4;
        }
        .mini-code {
            background-color: #1e1e1e;
            color: #ce9178;
            padding: 8px;
            border-radius: 4px;
            font-family: monospace;
            font-size: 12px;
            overflow-x: auto;
            white-space: pre-wrap;
            margin: 8px 0;
        }

        /* ปุ่มคัดลอกโค้ด */
        .btn-copy {
            background-color: #0e639c;
            color: white;
            border: none;
            padding: 4px 8px;
            font-size: 11px;
            border-radius: 3px;
            cursor: pointer;
            margin-top: 5px;
        }
        .btn-copy:hover { background-color: #1177bb; }

        /* ส่วนของ Live Editor (ขวาบน) และ Preview (ขวาล่าง) */
        .pane-header {
            background-color: #252526;
            padding: 8px 15px;
            font-size: 12px;
            font-weight: bold;
            color: #b5cea8;
            border-bottom: 1px solid #333;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .code-editor-pane {
            flex: 1;
            display: flex;
            flex-direction: column;
            border-bottom: 1px solid #333;
        }
        
        #html-input {
            flex: 1;
            background-color: #1e1e1e;
            color: #9cdcfe;
            font-family: 'Courier New', Courier, monospace;
            font-size: 14px;
            padding: 12px;
            border: none;
            resize: none;
            outline: none;
            line-height: 1.5;
        }

        .preview-pane {
            flex: 1;
            display: flex;
            flex-direction: column;
            background-color: #ffffff; /* หน้าพรีวิวเป็นสีขาวเหมือนบราวเซอร์จริง */
            color: #333;
        }

        #preview-frame {
            flex: 1;
            border: none;
            width: 100%;
            height: 100%;
        }

        /* แผงปุ่มควบคุมเพิ่มเติม */
        .toolbar {
            display: flex;
            gap: 8px;
        }
        .tool-btn {
            background-color: #333;
            color: #fff;
            border: 1px solid #555;
            padding: 3px 8px;
            font-size: 11px;
            border-radius: 3px;
            cursor: pointer;
        }
        .tool-btn:hover { background-color: #444; }
    </style>
</head>
<body>

    <header>
        <h1>💻 HTML Interactive Study & Sandbox</h1>
        <p>อ่านสรุปบทเรียนฝั่งซ้าย → ดูโค้ด → ฝึกพิมพ์ตามในกล่องขวา แล้วดูผลลัพธ์สดๆ ได้ทันที!</p>
    </header>

    <div class="workspace">
        
        <!-- ฝั่งซ้าย: บทเรียนสรุปแยกตามสเต็ป -->
        <div class="lessons-sidebar">
            
            <!-- สเต็ปที่ 1 -->
            <div class="lesson-card">
                <h3>1. โครงสร้างพื้นฐาน (HTML Skeleton)</h3>
                <p>รากฐานสำคัญที่ทุกเว็บต้องมี</p>
                <div class="mini-code" id="code-1">&lt;!DOCTYPE html&gt;
&lt;html lang="th"&gt;
&lt;head&gt;
    &lt;meta charset="UTF-8"&gt;
    &lt;title&gt;ทดลองพิมพ์&lt;/title&gt;
&lt;/head&gt;
&lt;body&gt;
    &lt;h1&gt;สวัสดีชาวโลก!&lt;/h1&gt;
    &lt;p&gt;นี่คือเว็บแรกของฉัน&lt;/p&gt;
&lt;/body&gt;
&lt;/html&gt;</div>
                <button class="btn-copy" onclick="loadToEditor('code-1')">📥 โหลดโค้ดนี้ลงช่องพิมพ์</button>
            </div>

            <!-- สเต็ปที่ 2 -->
            <div class="lesson-card">
                <h3>2. การจัดการข้อความ (Text Tags)</h3>
                <p>คำสั่งจัดรูปแบบข้อความและหัวเรื่อง</p>
                <div class="mini-code" id="code-2">&lt;h1&gt;หัวข้อใหญ่สุด H1&lt;/h1&gt;
&lt;h2&gt;หัวข้อรองลงมา H2&lt;/h2&gt;
&lt;p&gt;ย่อหน้าข้อความปกติ ใช้แท็ก &lt;strong&gt;ตัวหนา&lt;/strong&gt; และ &lt;em&gt;ตัวเอียง&lt;/em&gt; ได้&lt;/p&gt;</div>
                <button class="btn-copy" onclick="loadToEditor('code-2')">📥 โหลดโค้ดนี้ลงช่องพิมพ์</button>
            </div>

            <!-- สเต็ปที่ 3 -->
            <div class="lesson-card">
                <h3>3. ลิงก์และรูปภาพ (Links & Images)</h3>
                <div class="mini-code" id="code-3">&lt;a href="https://www.google.com" target="_blank"&gt;คลิกไปเว็บ Google&lt;/a&gt;
&lt;br&gt;&lt;br&gt;
&lt;img src="https://via.placeholder.com/150" alt="รูปตัวอย่าง"&gt;</div>
                <button class="btn-copy" onclick="loadToEditor('code-3')">📥 โหลดโค้ดนี้ลงช่องพิมพ์</button>
            </div>

            <!-- สเต็ปที่ 4 -->
            <div class="lesson-card">
                <h3>4. รายการข้อมูล (Lists)</h3>
                <div class="mini-code" id="code-4">&lt;h3&gt;ผลไม้ที่ชอบ:&lt;/h3&gt;
&lt;ul&gt;
    &lt;li&gt;ส้ม&lt;/li&gt;
    &lt;li&gt;กล้วย&lt;/li&gt;
    &lt;li&gt;มะละกอ&lt;/li&gt;
&lt;/ul&gt;</div>
                <button class="btn-copy" onclick="loadToEditor('code-4')">📥 โหลดโค้ดนี้ลงช่องพิมพ์</button>
            </div>

            <!-- สเต็ปที่ 5 -->
            <div class="lesson-card">
                <h3>5. ตารางข้อมูล (Tables)</h3>
                <div class="mini-code" id="code-5">&lt;table border="1" cellpadding="5"&gt;
    &lt;tr&gt;
        &lt;th&gt;ชื่อ&lt;/th&gt;
        &lt;th&gt;อายุ&lt;/th&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;td&gt;สมชาย&lt;/td&gt;
        &lt;td&gt;25&lt;/td&gt;
    &lt;/tr&gt;
&lt;/table&gt;</div>
                <button class="btn-copy" onclick="loadToEditor('code-5')">📥 โหลดโค้ดนี้ลงช่องพิมพ์</button>
            </div>

            <!-- สเต็ปที่ 6 -->
            <div class="lesson-card">
                <h3>6. แบบฟอร์ม (Forms)</h3>
                <div class="mini-code" id="code-6">&lt;form&gt;
    &lt;label&gt;ชื่อผู้ใช้:&lt;/label&gt;&lt;br&gt;
    &lt;input type="text" placeholder="กรอกชื่อของคุณ"&gt;&lt;br&gt;&lt;br&gt;
    &lt;button type="submit"&gt;ส่งข้อมูล&lt;/button&gt;
&lt;/form&gt;</div>
                <button class="btn-copy" onclick="loadToEditor('code-6')">📥 โหลดโค้ดนี้ลงช่องพิมพ์</button>
            </div>

        </div>

        <!-- ฝั่งขวา: พื้นที่เขียนโค้ดจริง และหน้าจอพรีวิวผลลัพธ์ -->
        <div class="editor-preview-area">
            
            <!-- ส่วนพิมพ์โค้ด (ด้านบน) -->
            <div class="code-editor-pane">
                <div class="pane-header">
                    <span>✏️ พื้นที่เขียน / แก้ไขโค้ด (Code Editor)</span>
                    <div class="toolbar">
                        <button class="tool-btn" onclick="clearEditor()">🧹 ล้างหน้าจอ</button>
                        <button class="tool-btn" onclick="resetDefault()">🔄 โหลดค่าเริ่มต้น</button>
                    </div>
                </div>
                <textarea id="html-input" placeholder="พิมพ์โค้ด HTML ของคุณที่นี่ หรือกดปุ่ม 'โหลดโค้ดนี้ลงช่องพิมพ์' จากฝั่งซ้ายได้เลย..."></textarea>
            </div>

            <!-- ส่วนแสดงผลลัพธ์ Preview (ด้านล่าง) -->
            <div class="preview-pane">
                <div class="pane-header" style="background-color: #e0e0e0; color: #333; border-bottom: 1px solid #ccc;">
                    <span>🌐 หน้าจอแสดงผลจริง (Live Preview)</span>
                </div>
                <iframe id="preview-frame"></iframe>
            </div>

        </div>

    </div>

    <script>
        const htmlInput = document.getElementById('html-input');
        const previewFrame = document.getElementById('preview-frame');

        // ฟังก์ชันอัปเดตหน้าพรีวิวแบบเรียลไทม์เมื่อมีการพิมพ์
        function updatePreview() {
            const code = htmlInput.value;
            const doc = previewFrame.contentDocument || previewFrame.contentWindow.document;
            doc.open();
            doc.write(code);
            doc.close();
        }

        htmlInput.addEventListener('input', updatePreview);

        // ฟังก์ชันดึงโค้ดจากบทเรียนฝั่งซ้ายมาใส่ในช่องพิมพ์อัตโนมัติ
        function loadToEditor(elementId) {
            const codeText = document.getElementById(elementId).innerText;
            htmlInput.value = codeText;
            updatePreview();
        }

        // ปุ่มล้างช่องพิมพ์
        function clearEditor() {
            htmlInput.value = '';
            updatePreview();
        }

        // โหลดค่าเริ่มต้นตอนเปิดเว็บครั้งแรก
        function resetDefault() {
            loadToEditor('code-1');
        }

        // รันค่าเริ่มต้นตอนเปิดหน้าเว็บ
        window.onload = resetDefault;
    </script>
</body>
</html>